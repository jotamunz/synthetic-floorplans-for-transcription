{
  "prompts": [
    "<record>\nWhat is {label}?",
    "What is {label}?\n<record>",
    "<record>\nDescribe {label}.",
    "Describe {label}.\n<record>",
    "<record>\nWhat does {label} represent?",
    "What does {label} represent?\n<record>"
  ],
  "answer": "a {direction} {kind} at the {position} of the {plan}",
  "unplaced_answer": "a {direction} {kind} in the {plan}",
  "relationships": {
    "joined": [
      {"templates": ["{a} {verb} {b}", "{b} {verb} {a}"],
       "verbs": ["is joined to", "is connected to", "is attached to", "is linked to"]},
      {"templates": ["{a} and {b} {verb}", "{b} and {a} {verb}"],
       "verbs": ["are joined", "are connected", "are attached", "are linked"]}
    ],
    "in": [
      {"templates": ["{a} {verb} {b}"],
       "verbs": ["is in", "is placed in", "is located in", "sits in", "stands in"]},
      {"templates": ["{b} {verb} {a}"],
       "verbs": ["contains", "holds", "includes"]}
    ]
  },
  "directions": [
    ["horizontal"],
    ["vertical"]
  ],
  "rows": [
    [""],
    ["top"],
    ["bottom"]
  ],
  "columns": [
    [""],
    ["left"],
    ["right"]
  ],
  "plans": ["floor plan", "floorplan", "layout", "apartment layout", "residential floor plan", "plan drawing",
            "architectural plan"],
  "classes": {
    "outside wall": {"singular": ["outside wall segment", "exterior wall segment", "external wall segment",
                                  "perimeter wall segment"],
                     "plural": ["outside wall segments", "exterior wall segments", "external wall segments",
                                "perimeter wall segments"]},
    "inside wall": {"singular": ["inside wall segment", "interior wall segment", "internal wall segment",
                                 "partition wall segment", "dividing wall segment"],
                    "plural": ["inside wall segments", "interior wall segments", "internal wall segments",
                               "partition wall segments", "dividing wall segments"]}
  }
}
