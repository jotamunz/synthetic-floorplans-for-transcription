       "verbs": ["are joined", "are connected", "are attached", "are linked"]}
    ],
    "in": [
      {"templates": ["{a} {verb} {b}"],
       "verbs": ["is in", "is placed in", "is located in", "sits in", "stands in"]},
      {"templates": ["{b} {verb} {a}"],
       "verbs": ["contains", "holds", "includes"]}
    ]
  },
  "directions": [
    ["horizontal"],
    ["vertical"]
  ],
  "rows": [
    [""],
    ["top"],
    ["bottom"]
  ],
  "columns": [
    [""],
    ["left"],
    ["right"]
  ],
  "plans": ["floor plan", "floorplan", "layout", "apartment layout", "residential floor plan", "plan drawing",
            "architectural plan"]
